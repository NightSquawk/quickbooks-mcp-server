{
  "name": "@nightsquawktech/quickbooks-mcp-server",
  "version": "0.1.0",
  "description": "QuickBooks Online MCP server for Claude, Cursor, and AI agents: entity CRUD and 29 financial reports. Fork of intuit/quickbooks-online-mcp-server.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "vendor/*.tgz"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "vendor:pack": "node scripts/pack-vendor.mjs",
    "package:release": "node scripts/package-release.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "lint:fix": "eslint --fix",
    "lint": "eslint .",
    "auth": "node dist/auth-server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "author": "Kevin Reyes (NightSquawk Tech) <hello@nightsquawk.tech>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NightSquawk/quickbooks-mcp-server.git"
  },
  "homepage": "https://github.com/NightSquawk/quickbooks-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/NightSquawk/quickbooks-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "claude",
    "cursor",
    "ai-agent",
    "llm",
    "quickbooks",
    "quickbooks-online",
    "qbo",
    "accounting",
    "intuit"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.7",
    "intuit-oauth": "file:vendor/intuit-oauth-4.2.5-nst.1.tgz",
    "node-quickbooks": "file:vendor/node-quickbooks-2.0.50-nst.1.tgz",
    "open": "^9.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "jest": "^30.2.0",
    "prettier": "3.5.3",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "engines": {
    "node": ">=22"
  }
}
