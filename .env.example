# Static app credentials. Copy to .env; never commit real values.
QUICKBOOKS_CLIENT_ID=your_client_id
QUICKBOOKS_CLIENT_SECRET=your_client_secret
QUICKBOOKS_ENVIRONMENT=sandbox
# Sandbox: registered HTTP loopback /callback URL; the configured port is used.
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/callback

# Sandbox auto-reauth defaults to true; production fails fast on tool calls.
# QBO_AUTO_REAUTH=false

# Rotating refresh token and realm ID are stored in .qbo-tokens.json, not .env.
# Optional absolute path to a writable JSON token store for this connection.
# Static credentials still come from the process environment or package .env.
# QUICKBOOKS_TOKEN_STORE_PATH=/absolute/path/to/.qbo-tokens.json

# Omit these or set false to register all tools. Set all three for read-only QBO access.
# QUICKBOOKS_DISABLE_WRITE=true
# QUICKBOOKS_DISABLE_UPDATE=true
# QUICKBOOKS_DISABLE_DELETE=true

# Optional local attachment roots, separated by semicolons. Defaults: home and temp.
# QUICKBOOKS_ATTACHABLE_BASE_DIR=/absolute/path/to/attachments
# PDF disk writes are disabled unless this existing directory is configured.
# QBO_PDF_OUTPUT_DIR=/absolute/path/to/invoices
# Decoded PDF download limit in bytes; defaults to 50 MiB.
# QBO_PDF_MAX_BYTES=52428800
