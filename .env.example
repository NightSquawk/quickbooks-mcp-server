# Static QuickBooks app credentials (safe to describe, NEVER commit real values).
# Copy this file to .env and fill in your values. .env is gitignored.
QUICKBOOKS_CLIENT_ID=your_client_id
QUICKBOOKS_CLIENT_SECRET=your_client_secret
QUICKBOOKS_ENVIRONMENT=sandbox

# Optional: set to false to fail fast with a "run npm run auth" message instead of
# auto-launching a browser when the refresh token is dead. Defaults to true.
# QBO_AUTO_REAUTH=true

# NOTE: The rotating refresh token and realm ID are NOT stored here. They are
# persisted to .qbo-tokens.json (also gitignored) at runtime, minted by
# `npm run auth` or the first tool call. The access token is kept in memory only.
